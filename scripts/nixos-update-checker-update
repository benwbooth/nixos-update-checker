#!/bin/sh
# NixOS Update Checker - Update Script
# This script is called by the GUI with pkexec to perform the actual update
# Expects update settings through environment variables supplied by the GUI

if [ -z "$FLAKE_PATH" ]; then
    echo "Error: FLAKE_PATH environment variable not set"
    echo "This script should be called from the NixOS Update Checker GUI."
    exit 1
fi

# Track if any step fails
FAILED=0

# Which parts to update (older GUIs set neither: update the system only).
UPDATE_SYSTEM="${UPDATE_SYSTEM:-1}"
FLATPAK_SYSTEM="${FLATPAK_SYSTEM:-0}"
FLATPAK_USER="${FLATPAK_USER:-0}"
# AppImages (ids in the flake's apps.json) to move to their newest release,
# and the program that does it (the GUI's own binary: `… apps update IDs`).
APPIMAGES="${APPIMAGES:-}"

find_ssh_agent_socket() {
    if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
        return
    fi

    INVOKING_UID="${ORIGINAL_UID:-${PKEXEC_UID:-}}"
    if [ -z "$INVOKING_UID" ]; then
        return
    fi

    for socket in \
        "/run/user/$INVOKING_UID/ssh-agent" \
        "/run/user/$INVOKING_UID/keyring/ssh" \
        "/run/user/$INVOKING_UID/gnupg/S.gpg-agent.ssh"
    do
        if [ -S "$socket" ]; then
            SSH_AUTH_SOCK="$socket"
            export SSH_AUTH_SOCK
            return
        fi
    done
}

prune_system_generations() {
    case "$GENERATION_PRUNE_VALUE" in
        ''|0|*[!0-9]*)
            echo "${YELLOW}Invalid generation pruning value; skipping generation pruning${NC}"
            return
            ;;
    esac

    case "$GENERATION_PRUNE_MODE" in
        keep-latest)
            PRUNE_SPEC="+$GENERATION_PRUNE_VALUE"
            echo "${BLUE}Keeping newest $GENERATION_PRUNE_VALUE system generations${NC}"
            ;;
        older-than)
            PRUNE_SPEC="${GENERATION_PRUNE_VALUE}d"
            echo "${BLUE}Removing system generations older than $GENERATION_PRUNE_VALUE days${NC}"
            ;;
        *)
            echo "${YELLOW}Invalid generation pruning mode; skipping generation pruning${NC}"
            return
            ;;
    esac

    if ! nix-env --profile /nix/var/nix/profiles/system --delete-generations "$PRUNE_SPEC"; then
        echo "${YELLOW}Generation pruning failed${NC}"
    fi
}

# ANSI color codes
BOLD=$'\033[1m'
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
MAGENTA=$'\033[0;35m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

echo "${BOLD}${CYAN}╔══════════════════════════════════════╗${NC}"
echo "${BOLD}${CYAN}║           Software Update            ║${NC}"
echo "${BOLD}${CYAN}╚══════════════════════════════════════╝${NC}"
echo ""

cd "$FLAKE_PATH"
echo "${BLUE}📁 Working directory:${NC} $(pwd)"

# Git and the lock file belong to whoever owns the flake. When that is a regular user (Ben's
# checkout on a child's PC, say), run them as that user: commits get their identity and
# pushes use their SSH key, whoever clicked Update. A root-owned flake keeps running as root.
FLAKE_OWNER=$(stat -c %U "$FLAKE_PATH")
as_owner() {
    if [ "$FLAKE_OWNER" = root ]; then
        "$@"
    else
        runuser -u "$FLAKE_OWNER" -- "$@"
    fi
}
echo "${BLUE}👤 Flake owner:${NC} $FLAKE_OWNER"
echo ""

# Add flake path to git safe directories (needed even as root in newer git)
git config --global --add safe.directory "$FLAKE_PATH"

update_flatpaks() {
    if [ "$FLATPAK_SYSTEM" = "1" ]; then
        echo "${BOLD}${GREEN}━━━ Updating Flatpak apps (system) ━━━${NC}"
        # Only the refs picked in the list (all of them when none are named).
        # shellcheck disable=SC2086
        if ! flatpak update --system --noninteractive -y $FLATPAK_SYSTEM_REFS; then
            echo "${RED}Failed to update system Flatpak apps${NC}"
            FAILED=1
        fi
        echo ""
    fi
    if [ "$FLATPAK_USER" = "1" ]; then
        echo "${BOLD}${GREEN}━━━ Updating Flatpak apps (user) ━━━${NC}"
        # The user's own installation lives in their home: run as them.
        FLATPAK_USER_NAME=$(getent passwd "${ORIGINAL_UID:-${PKEXEC_UID:-}}" | cut -d: -f1)
        FLATPAK_USER_HOME=$(getent passwd "${ORIGINAL_UID:-${PKEXEC_UID:-}}" | cut -d: -f6)
        if [ -z "$FLATPAK_USER_NAME" ]; then
            echo "${YELLOW}Could not tell which user to update Flatpak apps for; skipping${NC}"
        elif ! runuser -u "$FLATPAK_USER_NAME" -- env HOME="$FLATPAK_USER_HOME" \
                XDG_RUNTIME_DIR="/run/user/${ORIGINAL_UID:-${PKEXEC_UID:-}}" \
                flatpak update --user --noninteractive -y $FLATPAK_USER_REFS; then
            echo "${RED}Failed to update user Flatpak apps${NC}"
            FAILED=1
        fi
        echo ""
    fi
}

# Pins the newest releases of the picked AppImages in apps.json, as the
# flake's owner (it edits their file and downloads into the store). The
# rebuild that follows installs them.
update_appimages() {
    echo "${BOLD}${GREEN}━━━ Updating AppImages ━━━${NC}"
    if [ -z "$APPS_TOOL" ] || [ ! -x "$APPS_TOOL" ]; then
        echo "${RED}Can't update AppImages: the apps tool isn't there ($APPS_TOOL)${NC}"
        FAILED=1
    else
        # shellcheck disable=SC2086
        if ! as_owner env PATH="$PATH:/run/current-system/sw/bin" \
                "$APPS_TOOL" apps --manifest "$FLAKE_PATH/apps.json" update $APPIMAGES; then
            echo "${RED}Failed to update some AppImages${NC}"
            FAILED=1
        fi
    fi
    echo ""
}

rebuild_system() {
    echo "${BOLD}${MAGENTA}━━━ Rebuilding NixOS ━━━${NC}"
    if ! nixos-rebuild switch --flake .; then
        echo "${RED}Failed to rebuild NixOS${NC}"
        FAILED=1
    fi
    echo ""
}

if [ "$UPDATE_SYSTEM" != "1" ] && [ -n "$APPIMAGES" ]; then
    # AppImages without the rest of the flake: pin them and rebuild, leaving
    # the other inputs where they are.
    echo "${YELLOW}Updating AppImages without updating the flake's inputs${NC}"
    echo ""
    update_appimages
    rebuild_system
    update_flatpaks
elif [ "$UPDATE_SYSTEM" != "1" ]; then
    echo "${YELLOW}NixOS is up to date; updating Flatpak apps only${NC}"
    echo ""
    update_flatpaks
    COMMIT_AND_PUSH=0
    SKIP_SYSTEM_MSG=1
else

echo "${BOLD}${YELLOW}━━━ Updating flake inputs ━━━${NC}"
if ! as_owner env NIX_CONFIG='extra-experimental-features = nix-command flakes' nix flake update; then
    echo "${RED}Failed to update flake inputs${NC}"
    FAILED=1
fi
echo ""

if [ -n "$APPIMAGES" ]; then
    update_appimages
fi
rebuild_system

update_flatpaks
fi

if [ "$COMMIT_AND_PUSH" = "1" ]; then
    echo "${BOLD}${BLUE}━━━ Committing changes ━━━${NC}"
    # Forward the invoking user's SSH agent for push. When git runs as a different owner who
    # can't open that socket, ssh falls back to the owner's own keys.
    find_ssh_agent_socket
    if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
        echo "${BLUE}Using SSH agent:${NC} $SSH_AUTH_SOCK"
    else
        echo "${YELLOW}No SSH agent socket found; git push may ask for a key passphrase${NC}"
    fi

    # Commit only flake.lock and apps.json: the files this script changes
    # (`nix flake update`, and AppImage releases pinned in apps.json). A
    # blanket `git add -A` sweeps up unrelated work in progress in the flake
    # directory -- someone editing configuration.nix while an update runs --
    # and pushes it to the remote under this generic message. Committing the
    # paths explicitly also ignores anything already staged there.
    CHANGED=""
    for f in flake.lock apps.json; do
        if [ -e "$f" ] && ! as_owner git diff --quiet HEAD -- "$f"; then
            CHANGED="$CHANGED $f"
        fi
    done
    if [ -z "$CHANGED" ]; then
        echo "${YELLOW}No flake.lock or apps.json changes to commit${NC}"
    else
        # shellcheck disable=SC2086
        as_owner git commit -m "$COMMIT_MSG" -- $CHANGED \
            || echo "${YELLOW}Nothing to commit${NC}"
    fi
    echo ""
    echo "${BOLD}${CYAN}━━━ Pushing to remote ━━━${NC}"
    # If the agent has no key, ssh asks for the passphrase in the embedded
    # terminal, which forwards keyboard input to the running command.
    if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ] && ! SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1; then
        echo "${YELLOW}SSH agent has no keys loaded; enter your key passphrase if asked.${NC}"
    fi
    as_owner git push \
        || echo "${YELLOW}Push failed or no remote configured${NC}"
elif [ -z "$SKIP_SYSTEM_MSG" ]; then
    echo "${YELLOW}Skipping commit and push (disabled in settings)${NC}"
fi
echo ""

if [ "$PRUNE_GENERATIONS" = "1" ] && [ "$FAILED" -eq 0 ]; then
    echo "${BOLD}${MAGENTA}━━━ Pruning old system generations ━━━${NC}"
    prune_system_generations
    echo ""
elif [ "$PRUNE_GENERATIONS" = "1" ] && [ "$FAILED" -eq 1 ]; then
    echo "${YELLOW}Skipping generation pruning due to failed update${NC}"
    echo ""
fi

if [ "$RUN_GC" = "1" ] && [ "$FAILED" -eq 0 ]; then
    echo "${BOLD}${MAGENTA}━━━ Running garbage collection ━━━${NC}"
    nix-collect-garbage || echo "${YELLOW}Garbage collection failed${NC}"
    echo ""
elif [ "$RUN_GC" = "1" ] && [ "$FAILED" -eq 1 ]; then
    echo "${YELLOW}Skipping garbage collection due to failed update${NC}"
    echo ""
fi

# Final status - this will be the status line
echo ""
if [ "$FAILED" -eq 1 ]; then
    echo "${BOLD}${RED}✗ Update failed${NC}"
    exit 1
else
    echo "${BOLD}${GREEN}✓ Update complete!${NC}"
    exit 0
fi
