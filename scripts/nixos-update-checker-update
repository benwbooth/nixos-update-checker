#!/bin/sh
# NixOS Update Checker - Update Script
# This script is called by the GUI with pkexec to perform the actual update
# Expects FLAKE_PATH and COMMIT_MSG environment variables

if [ -z "$FLAKE_PATH" ]; then
    echo "Error: FLAKE_PATH environment variable not set"
    echo "This script should be called from the NixOS Update Checker GUI."
    exit 1
fi

# Track if any step fails
FAILED=0

find_ssh_agent_socket() {
    if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
        return
    fi

    INVOKING_UID="${ORIGINAL_UID:-${PKEXEC_UID:-}}"
    if [ -z "$INVOKING_UID" ]; then
        return
    fi

    for socket in \
        "/run/user/$INVOKING_UID/ssh-agent" \
        "/run/user/$INVOKING_UID/keyring/ssh" \
        "/run/user/$INVOKING_UID/gnupg/S.gpg-agent.ssh"
    do
        if [ -S "$socket" ]; then
            SSH_AUTH_SOCK="$socket"
            export SSH_AUTH_SOCK
            return
        fi
    done
}

# ANSI color codes
BOLD=$'\033[1m'
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
MAGENTA=$'\033[0;35m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

echo "${BOLD}${CYAN}╔══════════════════════════════════════╗${NC}"
echo "${BOLD}${CYAN}║       NixOS Flake Update             ║${NC}"
echo "${BOLD}${CYAN}╚══════════════════════════════════════╝${NC}"
echo ""

cd "$FLAKE_PATH"
echo "${BLUE}📁 Working directory:${NC} $(pwd)"
echo ""

# Add flake path to git safe directories (needed even as root in newer git)
git config --global --add safe.directory "$FLAKE_PATH"

echo "${BOLD}${YELLOW}━━━ Updating flake inputs ━━━${NC}"
if ! NIX_CONFIG='extra-experimental-features = nix-command flakes' nix flake update; then
    echo "${RED}Failed to update flake inputs${NC}"
    FAILED=1
fi
echo ""

echo "${BOLD}${MAGENTA}━━━ Rebuilding NixOS ━━━${NC}"
if ! nixos-rebuild switch --flake .; then
    echo "${RED}Failed to rebuild NixOS${NC}"
    FAILED=1
fi
echo ""

if [ "$COMMIT_AND_PUSH" = "1" ]; then
    echo "${BOLD}${BLUE}━━━ Committing changes ━━━${NC}"
    # Keep Git as root for root-owned flakes, but forward the user's SSH agent for push.
    find_ssh_agent_socket
    if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
        echo "${BLUE}Using SSH agent:${NC} $SSH_AUTH_SOCK"
    else
        echo "${YELLOW}No SSH agent socket found; git push may ask for a key passphrase${NC}"
    fi

    git add -A
    git commit -m "$COMMIT_MSG" || echo "${YELLOW}Nothing to commit${NC}"
    echo ""
    echo "${BOLD}${CYAN}━━━ Pushing to remote ━━━${NC}"
    # Never let ssh block on an interactive prompt: this runs in an embedded
    # terminal that may not accept keyboard input. BatchMode makes ssh fail
    # fast (instead of asking for a key passphrase) when the agent has no
    # usable key, so the update finishes cleanly and the user can push later.
    if [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ] && ! SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1; then
        echo "${YELLOW}SSH agent has no keys loaded; push will likely be skipped.${NC}"
        echo "${YELLOW}Run 'ssh-add' as your user to load your key, then push manually.${NC}"
    fi
    GIT_SSH_COMMAND="ssh -o BatchMode=yes" git push \
        || echo "${YELLOW}Push failed or no remote configured (agent has no key?)${NC}"
else
    echo "${YELLOW}Skipping commit and push (disabled in settings)${NC}"
fi
echo ""

if [ "$RUN_GC" = "1" ] && [ "$FAILED" -eq 0 ]; then
    echo "${BOLD}${MAGENTA}━━━ Running garbage collection ━━━${NC}"
    nix-collect-garbage || echo "${YELLOW}Garbage collection failed${NC}"
    echo ""
elif [ "$RUN_GC" = "1" ] && [ "$FAILED" -eq 1 ]; then
    echo "${YELLOW}Skipping garbage collection due to failed update${NC}"
    echo ""
fi

# Final status - this will be the status line
echo ""
if [ "$FAILED" -eq 1 ]; then
    echo "${BOLD}${RED}✗ Update failed${NC}"
    exit 1
else
    echo "${BOLD}${GREEN}✓ Update complete!${NC}"
    exit 0
fi
